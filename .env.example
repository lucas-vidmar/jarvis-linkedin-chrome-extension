# Set the factory-default recipient for Jarvis syncs.
# Default (no value set): jarvis@agileengine.com
# This is the value used when no custom recipient has been saved in the
# extension popup (Settings → Sync recipient). Changing it here only affects
# fresh installs — the saved value in chrome.storage wins at runtime.
WXT_JARVIS_RECIPIENT=

# Google Cloud OAuth client ID used by chrome.identity.getAuthToken().
# Leave blank to use the client ID pinned in wxt.config.ts. The client must be
# of type "Chrome extension" and registered for this extension's pinned ID
# (run `npm run build && npm run extension:id` to print it).
WXT_GOOGLE_CLIENT_ID=

# Optional override for the pinned extension public key (base64 DER
# SubjectPublicKeyInfo). Changing it changes the extension ID, which then
# requires a matching update to the Google Cloud OAuth client. Never commit the
# private key — this is only the public half.
WXT_EXTENSION_KEY=
